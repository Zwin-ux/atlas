PORT=8787
MCP_PATH=/mcp
WIDGET_DOMAIN=https://atlas.local
GEO_DATA_ADAPTER=mock
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=us
GOOGLE_MAPS_LANGUAGE=en

# Scene packet cache / job spine (0.72B). Local dev defaults to memory.
# Railway production should set redis + ATLAS_REDIS_URL. Browser pan/zoom stays
# local after ChatGPT delivers _meta.generatedDraftScene.
ATLAS_SCENE_PACKET_CACHE_BACKEND=memory
ATLAS_REDIS_URL=
ATLAS_SCENE_PACKET_WORKER_ENABLED=false
ATLAS_SCENE_PACKET_LOCK_TTL_SECONDS=30
ATLAS_SCENE_PACKET_LOCK_WAIT_MS=2000

# Hosted Clawd persistence foundation (0.60H). All OFF/empty by default.
# Postgres connection for owner-protected Hosted Clawd rows. Leave empty to
# keep Atlas session-only; persistence also requires the flag below.
DATABASE_URL=

# OAuth/OIDC account linking for protected Hosted Clawd writes.
# Auth0-compatible issuer/audience/JWKS, server-only. Bearer tokens are
# verified against issuer, audience, expiry, and signing keys.
ATLAS_OIDC_ISSUER=
ATLAS_OIDC_AUDIENCE=
ATLAS_OIDC_JWKS_URL=
# Optional explicit protected-resource URL (defaults to request host + MCP path).
ATLAS_OIDC_RESOURCE=

# Hosted Clawd gates. Persistence may be enabled only for owner-protected
# 0.60H writes. Money may be enabled only for 0.62H test billing with Stripe
# test-mode keys and webhook state; public-claim stays closed.
ATLAS_HOSTED_CLAWD_PERSISTENCE_ENABLED=false
ATLAS_HOSTED_CLAWD_MONEY_ENABLED=false
ATLAS_HOSTED_CLAWD_PUBLIC_CLAIM_ENABLED=false

# Hosted Clawd Stripe test billing (0.62H). Server-only. Leave empty unless
# ATLAS_HOSTED_CLAWD_MONEY_ENABLED=true for a named test-billing run.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_HOSTED_CLAWD_PRICE_ID=
STRIPE_API_VERSION=2026-02-25.clover
APP_BASE_URL=http://localhost:8787
