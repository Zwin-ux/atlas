{
  "name": "atlas-chatgpt-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "env:check": "node scripts/check-env.mjs",
    "build:core": "pnpm --dir packages/core build",
    "build:web": "pnpm build:core && node scripts/build-web.mjs",
    "build:geo": "pnpm --dir packages/geo build",
    "build:server": "pnpm build:core && pnpm build:geo && tsc -p server/tsconfig.json",
    "build:starter": "pnpm build:web && pnpm build:server && pnpm build:atlas-plates",
    "build:workspaces": "tsc -p packages/config/tsconfig.json && tsc -p packages/core/tsconfig.json && tsc -p packages/assets/tsconfig.json && tsc -p packages/geo/tsconfig.json && tsc -p packages/mcp/tsconfig.json && tsc -p apps/web/tsconfig.json && pnpm --dir apps/widget build",
    "build": "pnpm build:starter && pnpm build:workspaces",
    "typecheck:starter": "pnpm build:core && pnpm build:geo && tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "typecheck:workspaces": "tsc -p packages/config/tsconfig.json --noEmit && tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/assets/tsconfig.json --noEmit && tsc -p packages/geo/tsconfig.json --noEmit && tsc -p packages/mcp/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/widget/tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:starter && pnpm typecheck:workspaces",
    "test:core": "pnpm --dir packages/core test",
    "test:atlas-controller": "tsx --test web/test/atlas-map-controller.test.ts",
    "test:hosted-clawd": "tsx --test server/test/hosted-clawd-persistence-foundation.test.ts",
    "test:hosted-clawd-billing": "tsx --test server/test/hosted-clawd-stripe-test-billing.test.ts",
    "test:hosted-clawd-protected-tool-gate": "tsx --test server/test/hosted-clawd-protected-tool-gate.test.ts",
    "test:hosted-clawd-saved-read-surface": "tsx --test server/test/hosted-clawd-saved-read-surface.test.ts",
    "test:atlas-commons": "tsx --test server/test/atlas-commons-public-notes.test.ts",
    "verify:mcp": "node scripts/verify-mcp-flow.mjs",
    "verify:hosted-clawd-persistence": "node scripts/verify-hosted-clawd-persistence-foundation.mjs",
    "verify:hosted-clawd-stripe-billing": "node scripts/verify-hosted-clawd-stripe-billing.mjs",
    "verify:hosted-clawd-protected-tool-gate": "node scripts/verify-hosted-clawd-protected-tool-gate.mjs",
    "verify:hosted-clawd-saved-read-surface": "node scripts/verify-hosted-clawd-saved-read-surface.mjs",
    "verify:hosted-clawd-saved-read-surface:browser": "node scripts/verify-hosted-clawd-saved-read-browser.mjs",
    "verify:atlas-commons": "node scripts/verify-atlas-commons-public-notes.mjs",
    "verify:atlas-commons:browser": "node scripts/verify-atlas-commons-browser.mjs",
    "verify:atlas-commons:staging": "node scripts/verify-atlas-commons-staging.mjs",
    "verify:hosted-clawd-browser-proof": "node scripts/verify-hosted-clawd-browser-proof.mjs",
    "verify:hosted-clawd-save-ux": "node scripts/verify-hosted-clawd-save-ux.mjs",
    "verify:hosted-clawd-save-ux:browser": "node scripts/verify-hosted-clawd-save-ux-browser.mjs",
    "verify:web-bundle-budget": "node scripts/verify-web-bundle-budget.mjs",
    "verify:mobile-interaction-hardening": "node scripts/verify-mobile-interaction-hardening.mjs",
    "verify:graphics-cleanup": "node scripts/verify-city-world-graphics-cleanup.mjs",
    "verify:deterministic-generated-districts": "node scripts/verify-deterministic-generated-district-specs.mjs",
    "verify:generated-draft-scene-packet": "node scripts/verify-generated-draft-scene-packet.mjs",
    "verify:county-town-anchors": "node scripts/verify-county-town-anchors.mjs",
    "verify:county-geo-packs": "node scripts/verify-county-geo-packs.mjs",
    "verify:production-backend-spine": "node scripts/verify-production-backend-spine.mjs",
    "verify:national-generation-production": "node scripts/verify-national-generation-production-contract.mjs",
    "verify:national-shells": "node scripts/verify-national-shells.mjs",
    "smoke:hosted-clawd:postgres": "tsx server/test/hosted-clawd-postgres-smoke.ts",
    "smoke:atlas-commons:postgres": "tsx server/test/atlas-commons-postgres-smoke.ts",
    "migrate:hosted-clawd": "tsx server/src/hostedClawd/migrations.ts",
    "migrate:hosted-clawd:built": "node scripts/run-hosted-clawd-migrations.mjs",
    "start:scene-packet-worker": "node server/dist/scenePacketWorker.js",
    "verify:railway-production-stack": "node scripts/verify-railway-production-stack.mjs",
    "verify:submission": "node scripts/verify-submission.mjs",
    "verify:preview:http": "node scripts/verify-preview-http.mjs",
    "verify:widget:perf": "node scripts/verify-widget-performance.mjs",
    "verify:emulator:perf": "node scripts/verify-emulator-perf.mjs",
    "verify:emulator:audit": "node scripts/verify-emulator-audit.mjs",
    "ship:check": "node scripts/ship-check.mjs",
    "ship:check:local": "node scripts/ship-check.mjs --skip-live",
    "check": "pnpm env:check && pnpm typecheck && pnpm build",
    "dev:widget": "pnpm --dir apps/widget dev",
    "dev": "pnpm build:web && pnpm build:geo && tsx server/src/index.ts",
    "start": "node scripts/railway-start.mjs",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector@latest --server-url http://localhost:8787/mcp --transport http",
    "verify:location-truth": "node scripts/verify-location-truth.mjs",
    "build:atlas-plates": "node scripts/build-atlas-plates.mjs"
  },
  "dependencies": {
    "@atlas/core": "workspace:*",
    "@atlas/geo": "workspace:*",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "pixi.js": "8.19.0",
    "radix-ui": "^1.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.1.0",
    "stripe": "^22.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  }
}
