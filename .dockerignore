# Keep the build context to what actually builds or runs the server.
#
# This is not only about speed. Everything listed here is something that must
# never end up inside a published image — local env files, browser profiles,
# session logs, and the .git history.

.git
.gitignore
node_modules
**/node_modules
**/dist
artifacts/atlas-plates

# Local environment and credentials. Never in an image.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# Agent, session, and tooling state.
.claude
.codex
.agents
.gstack
.context
.tmp-*
.reference
browser-data
browser-profile
*.log
.atlas-*.log

# Documentation, prompts, and research. Large, and none of it runs.
docs
prompts
prompt-pack
engineering-prompt-pack
experiments
site
assets/reference
.github

# Generated proof artefacts. Regenerated by verifiers, not read at runtime.
artifacts
!artifacts/.gitkeep

# Tests and test fixtures.
**/*.test.ts
**/test
migrations
