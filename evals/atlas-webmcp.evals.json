      }
    ],
    "expectedCall": [
      {
        "functionName": "get_map_state",
        "arguments": {},
        "mockOutput": { "ok": true, "revision": 0, "visibleRevision": 0, "current": { "level": "nation" }, "noteCount": 0, "recentNotes": [], "trail": null }
      }
    ]
  },
