[
  {
    "name": "[direct] Read the current shared map",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "What am I looking at in Atlas right now?"
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_map_state",
        "arguments": {},
        "mockOutput": {
          "ok": true,
          "revision": 0,
          "visibleRevision": 0,
          "current": { "level": "nation" },
          "noteCount": 0,
          "recentNotes": [],
          "trail": null
        }
      }
    ]
  },
  {
    "name": "[direct] Search for a specific county",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "I'm researching Riverside County, California. Find the Atlas match first so I can check it before we move."
      }
    ],
    "expectedCall": [
      {
        "functionName": "search_places",
        "arguments": { "query": { "$contains": "Riverside" } },
        "mockOutput": {
          "ok": true,
          "query": "Riverside County, California",
          "candidates": [
            {
              "name": "Riverside County",
              "countyName": "Riverside County",
              "countySlug": "riverside-ca",
              "state": "ca",
              "kind": "county"
            }
          ]
        }
      }
    ]
  },
  {
    "name": "[direct] Open one unambiguous county",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Take me to Riverside County, California."
      }
    ],
    "expectedCall": [
      {
        "functionName": "open_place",
        "arguments": { "place": { "$contains": "Riverside" } },
        "mockOutput": {
          "ok": true,
          "revision": 1,
          "mapChanged": true,
          "visible": true,
          "view": { "level": "county", "name": "Riverside County", "state": "ca" },
          "place": {
            "name": "Riverside County",
            "countyName": "Riverside County",
            "countySlug": "riverside-ca",
            "state": "ca",
            "kind": "county"
          }
        }
      }
    ]
  },
  {
    "name": "[critical] Add one note without creating a trail",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "At Miami-Dade County, Florida, leave this note for me: Compare transit access around county offices."
      }
    ],
    "expectedCall": [
      {
        "functionName": "add_map_note",
        "arguments": {
          "place": { "$contains": "Miami-Dade" },
          "body": { "$contains": "transit access" }
        },
        "mockOutput": {
          "ok": true,
          "revision": 1,
          "mapChanged": true,
          "noteAdded": true,
          "visible": true,
          "view": { "level": "county", "name": "Miami-Dade County", "state": "fl" },
          "note": {
            "id": "note-1",
            "body": "Compare transit access around county offices.",
            "place": {
              "name": "Miami-Dade County",
              "countyName": "Miami-Dade County",
              "countySlug": "miami-dade-fl",
              "state": "fl",
              "kind": "county"
            }
          }
        }
      }
    ]
  },
  {
    "name": "[critical] Create an ordered three-stop civic trail",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Set up a research trail called County access check: first Riverside County, CA for public records, then Miami-Dade County, FL for transit access, then Travis County, TX for meeting notices."
      }
    ],
    "expectedCall": [
      {
        "functionName": "create_map_trail",
        "arguments": {
          "title": { "$contains": "County access" },
          "stops": [
            {
              "place": { "$contains": "Riverside" },
              "prompt": { "$contains": "public records" }
            },
            {
              "place": { "$contains": "Miami-Dade" },
              "prompt": { "$contains": "transit access" }
            },
            {
              "place": { "$contains": "Travis" },
              "prompt": { "$contains": "meeting notices" }
            }
          ]
        },
        "mockOutput": {
          "ok": true,
          "revision": 1,
          "mapChanged": true,
          "trailChanged": true,
          "visible": true,
          "view": { "level": "nation", "overlay": "research_trail" },
          "title": "County access check",
          "stopCount": 3,
          "stops": [
            { "name": "Riverside County", "state": "ca" },
            { "name": "Miami-Dade County", "state": "fl" },
            { "name": "Travis County", "state": "tx" }
          ]
        }
      }
    ]
  },
  {
    "name": "[ambiguity] Search Springfield before any open",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "I'd like to look at Springfield, but I'm not sure which state. Show me the choices first."
      }
    ],
    "expectedCall": [
      {
        "functionName": "search_places",
        "arguments": { "query": "Springfield" },
        "mockOutput": {
          "ok": true,
          "query": "Springfield",
          "candidates": [
            { "name": "Springfield", "countyName": "Greene County", "countySlug": "greene-mo", "state": "mo", "kind": "place" },
            { "name": "Springfield", "countyName": "Sangamon County", "countySlug": "sangamon-il", "state": "il", "kind": "place" }
          ]
        }
      }
    ]
  },
  {
    "name": "[chain] Read state then search then open",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Read the current Atlas state, search for Riverside County, California, then open the unambiguous county result."
      }
    ],
    "expectedCall": [
      {
        "ordered": [
          {
            "functionName": "get_map_state",
            "arguments": {},
            "mockOutput": {
              "ok": true,
              "revision": 0,
              "visibleRevision": 0,
              "current": { "level": "nation" },
              "noteCount": 0,
              "recentNotes": [],
              "trail": null
            }
          },
          {
            "functionName": "search_places",
            "arguments": { "query": { "$contains": "Riverside" } },
            "mockOutput": {
              "ok": true,
              "query": "Riverside County, California",
              "candidates": [
                { "name": "Riverside County", "countyName": "Riverside County", "countySlug": "riverside-ca", "state": "ca", "kind": "county" }
              ]
            }
          },
          {
            "functionName": "open_place",
            "arguments": { "place": { "$contains": "Riverside" } },
            "mockOutput": {
              "ok": true,
              "revision": 1,
              "mapChanged": true,
              "visible": true,
              "view": { "level": "county", "name": "Riverside County", "state": "ca" },
              "place": { "name": "Riverside County", "countyName": "Riverside County", "countySlug": "riverside-ca", "state": "ca", "kind": "county" }
            }
          }
        ]
      }
    ]
  },
  {
    "name": "[critical] Failed trail is followed by an unchanged state read",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Read the map state, try to create a trail titled Unknown-stop check with Riverside County, CA for records and Atlantis-by-the-Pacific for permits, then read the map state again so I can confirm the failed stop did not partially change anything."
      }
    ],
    "expectedCall": [
      {
        "ordered": [
          {
            "functionName": "get_map_state",
            "arguments": {},
            "mockOutput": { "ok": true, "revision": 0, "visibleRevision": 0, "current": { "level": "nation" }, "noteCount": 0, "recentNotes": [], "trail": null }
          },
          {
            "functionName": "create_map_trail",
            "arguments": {
              "title": { "$contains": "Unknown-stop" },
              "stops": [
                { "place": { "$contains": "Riverside" }, "prompt": { "$contains": "records" } },
                { "place": "Atlantis-by-the-Pacific", "prompt": { "$contains": "permits" } }
              ]
            },
            "mockOutput": {
              "ok": false,
              "mapChanged": false,
              "trailChanged": false,
              "stopNumber": 2,
              "error": {
                "code": "UNKNOWN_PLACE",
                "message": "Atlas could not find that place. Try a nearby candidate or include the state.",
                "stopIndex": 1,
                "candidates": []
              }
            }
          },
          {
            "functionName": "get_map_state",
            "arguments": {},
            "mockOutput": { "ok": true, "revision": 0, "visibleRevision": 0, "current": { "level": "nation" }, "noteCount": 0, "recentNotes": [], "trail": null }
          }
        ]
      }
    ]
  },
  {
    "name": "[safe] A state read must not choose a write tool",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "I moved around the map myself. What does Atlas show now?"
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_map_state",
        "arguments": {},
        "mockOutput": { "ok": true, "revision": 0, "visibleRevision": 0, "current": { "level": "nation" }, "noteCount": 0, "recentNotes": [], "trail": null }
      }
    ]
  },
  {
    "name": "[follow-up] Open the Springfield chosen in conversation",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Take me to Springfield."
      },
      {
        "role": "model",
        "type": "message",
        "content": "Which Springfield do you mean?"
      },
      {
        "role": "user",
        "type": "message",
        "content": "The one in Illinois."
      }
    ],
    "expectedCall": [
      {
        "functionName": "open_place",
        "arguments": { "place": { "$pattern": "(?i)^(?=.*Springfield)(?=.*(?:IL|Illinois)).*$" } },
        "mockOutput": {
          "ok": true,
          "revision": 1,
          "mapChanged": true,
          "visible": true,
          "view": { "level": "county", "name": "Sangamon County", "state": "il" },
          "place": { "name": "Springfield", "countyName": "Sangamon County", "countySlug": "sangamon-il", "state": "il", "kind": "place" }
        }
      }
    ]
  },
  {
    "name": "[human-action] Read the map after the person moves it",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "I clicked the second trail stop myself. What am I looking at now?"
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_map_state",
        "arguments": {},
        "mockOutput": {
          "ok": true,
          "revision": 2,
          "visibleRevision": 2,
          "current": { "level": "county", "countySlug": "miami-dade-fl", "name": "Miami-Dade County", "state": "fl" },
          "selectedPlace": { "name": "Miami-Dade County", "countyName": "Miami-Dade County", "state": "fl", "kind": "county" },
          "noteCount": 0,
          "recentNotes": [],
          "trail": { "title": "County access check", "activeIndex": 1, "stops": [] }
        }
      }
    ]
  },
  {
    "name": "[safe] General county question needs no site tool",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "In one sentence, explain what a U.S. county is. Do not use Atlas or change the page."
      }
    ],
    "expectedCall": null
  }
]
